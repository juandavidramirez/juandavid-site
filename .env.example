# Public URL of the site (canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.tudominio.com

# Contact form → email, via Resend (https://resend.com). Server-only: never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Where messages are delivered (comma-separated for several recipients).
CONTACT_TO_EMAIL=tu-correo@ejemplo.com
# Sender. Must belong to a domain verified in Resend. For quick tests you can use onboarding@resend.dev
# (Resend only delivers those to the email of your Resend account).
CONTACT_FROM_EMAIL="Juan David Ramírez <contacto@tudominio.com>"
